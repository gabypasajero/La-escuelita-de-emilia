{
  "expo": {
    "name": "La Escuelita de Emilia",
    "slug": "la-escuelita-de-emilia",
    "scheme": "escuelita",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.escuelitadeemilia.app"
    },
    "android": {
      "package": "com.escuelitadeemilia.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "La Escuelita de Emilia",
      "shortName": "Escuelita",
      "themeColor": "#FDD835",
      "backgroundColor": "#FFE082",
      "lang": "es",
      "favicon": "./public/iconos/icono-48.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}